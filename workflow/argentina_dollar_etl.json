      "id": "a1b2c3d4-0002-4002-8002-000000000002",
      "name": "Fetch Dollar Rates",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Transform dolarapi.com response into clean, analysis-ready rows.\n// Endpoint /v1/dolares returns an array of dollar types (oficial, blue, mep, ccl, etc.).\n// The HTTP Request node emits each array element as a separate item.\n\nconst ingestedAt = new Date().toISOString();\nconst today = ingestedAt.split('T')[0];\nconst results = [];\n\nfor (const item of $input.all()) {\n  const d = item.json;\n\n  // Defensive: skip malformed records\n  if (!d || d.casa === undefined) continue;\n\n  const compra = d.compra ?? null;\n  const venta = d.venta ?? null;\n  const spread =\n    compra !== null && venta !== null\n      ? Number((venta - compra).toFixed(2))\n      : null;\n\n  results.push({\n    json: {\n      fecha: d.fechaActualizacion ? d.fechaActualizacion.split('T')[0] : today,\n      casa: d.casa,\n      nombre: d.nombre ?? d.casa,\n      moneda: d.moneda ?? 'USD',\n      compra: compra,\n      venta: venta,\n      spread: spread,\n      ingested_at: ingestedAt,\n    },\n  });\n}\n\nreturn results;\n"
      },
      "id": "a1b2c3d4-0003-4003-8003-000000000003",
      "name": "Transform & Clean",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        300
      ]
    },
